rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is super admin
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'cbokilo18@gmail.com';
    }
    
    // Users collection - admin can read all, users can read their own
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }
    
    // Notifications collection - admin can create all, users can read their own
    match /notifications/{notificationId} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }
    
    // Products collection - users can read/write their own products
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
    
    // Customers collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Boutique settings - per user
    match /boutiques/{boutiqueId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || boutiqueId == 'user');
    }
    
    // Conversations collection - users can read/write conversations they participate in.
    // Admin can read/update any conversation for oversight and support.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.storeId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.buyerId == request.auth.uid || request.resource.data.storeId == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.storeId == request.auth.uid || isAdmin());
    }
    
    // Messages collection - users can read/write messages in conversations they participate in
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Themes collection - users can read/write their own themes
    match /themes/{themeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Payments collection - users can read their own payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Subscriptions collection - users can read/update their own subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Email verification logs - users can read their own logs
    match /emailVerificationLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Token wallets - users can read/update their own wallet
    match /tokenWallets/{walletId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Token transactions - users can read their own transactions
    match /tokenTransactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Referrals - users can read their own referrals
    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || resource.data.referredId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.referrerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.referrerId == request.auth.uid;
    }

    // Visit history - users can read their own visit history
    match /visitHistory/{visitId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
